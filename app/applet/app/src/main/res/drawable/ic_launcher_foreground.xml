<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Glass Ring with Gradient -->
    <path
        android:pathData="M 54,12 A 42,42 0 1 1 53.99,12 Z"
        android:strokeWidth="2"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="12"
                android:startY="12"
                android:endX="96"
                android:endY="96"
                android:type="linear">
                <item android:color="#FFD700" android:offset="0.0" />
                <item android:color="#FF8C00" android:offset="0.3" />
                <item android:color="#A020F0" android:offset="0.6" />
                <item android:color="#00D2FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Base Inner Dark Glass Sphere -->
    <path
        android:pathData="M 54,20 A 34,34 0 1 1 53.99,20 Z"
        android:fillColor="#0A0E26" />

    <!-- Orange Fluid Swirl (Top-Left) -->
    <path
        android:pathData="M 54,20 A 34,34 0 0 0 20,54 C 32,42 48,68 88,54 A 34,34 0 0 0 54,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="40"
                android:centerY="35"
                android:gradientRadius="40"
                android:type="radial">
                <item android:color="#FFE57F" android:offset="0.0" />
                <item android:color="#FF9100" android:offset="0.4" />
                <item android:color="#DD2C00" android:offset="0.8" />
                <item android:color="#5D0000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Blue Fluid Swirl (Bottom-Right) -->
    <path
        android:pathData="M 54,20 A 34,34 0 1 1 20,54 C 32,65 65,35 54,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="68"
                android:centerY="72"
                android:gradientRadius="45"
                android:type="radial">
                <item android:color="#80D8FF" android:offset="0.0" />
                <item android:color="#0091EA" android:offset="0.35" />
                <item android:color="#002171" android:offset="0.8" />
                <item android:color="#030825" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dynamic Curved Fluid Wave Accent Line -->
    <path
        android:pathData="M 24,51 Q 42,32 58,51 T 84,52"
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFFF"
        android:fillColor="#00000000" />

    <!-- Glass Specular Highlight -->
    <path
        android:pathData="M 54,20 A 34,34 0 1 1 53.99,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:type="linear">
                <item android:color="#A0FFFFFF" android:offset="0.0" />
                <item android:color="#30E2D0FF" android:offset="0.4" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glass Rim Glowing Outline -->
    <path
        android:pathData="M 54,20 A 34,34 0 1 1 53.99,20 Z"
        android:strokeWidth="0.8"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="88"
                android:endX="88"
                android:endY="20"
                android:type="linear">
                <item android:color="#E000F0FF" android:offset="0.0" />
                <item android:color="#40FFFFFF" android:offset="0.5" />
                <item android:color="#E0FFAA00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
