<?xml version="1.0" encoding="utf-8"?>
<!-- Keep-alive only. canRetrieveWindowContent=false + an empty onAccessibilityEvent mean this
     service reads NOTHING; it exists solely to keep the app process alive without a status-bar
     icon. Declares the minimum needed to be enable-able. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/keepalive_accessibility_desc"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="1000"
    android:canRetrieveWindowContent="false" />
